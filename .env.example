# Supabase (base de datos, auth de admins, almacenamiento de archivos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para el servidor (nunca exponer al navegador): usado para operaciones de admin y storage privado
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp del taller, formato internacional sin "+" (ej. numero de Nicaragua: 505XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=50588888888

# Pasarela de pago activa: "manual" hoy, "bac" cuando esté integrada (ver lib/payments)
PAYMENT_PROVIDER=manual

# Notificación por correo cuando entra un pedido nuevo (opcional).
# Cuenta gratis en resend.com -> API Keys -> crear una.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# --- Variables reservadas para cuando llegue la documentación de BAC ---
